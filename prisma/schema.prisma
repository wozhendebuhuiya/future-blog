// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ==========================================
// 数据模型 (Model) 定义区域
// 相当于在这里画图纸，告诉 Prisma 数据库表长什么样
// ==========================================

// 定义一个 User 表
model User {
  id        Int      @id @default(autoincrement()) // 主键，自动递增的整数 (1, 2, 3...)
  username  String   @unique                       // 账号，字符串类型，并且必须唯一 (不能有两个相同的账号)
  password  String                                 // 密码，字符串类型
  role      String   @default("User")              // 角色，默认为普通用户
  skills    String?                                // 技能列表（以逗号分隔的字符串），加了 ? 表示这是可选的 (可为 null)
  createdAt DateTime @default(now())               // 创建时间，默认取当前时间
  updatedAt DateTime @updatedAt                    // 更新时间，每次修改记录时自动更新
  
  // 【新增】：告诉 Prisma，一个 User 可以有多篇 Post (一对多关系)
  posts     Post[]
}

// 定义一个 Post 表（博客文章）
model Post {
  id        Int      @id @default(autoincrement()) // 主键
  title     String                                 // 文章标题
  content   String                                 // 文章内容
  excerpt   String?                                 // 文章摘要
  category  String  @default("React")                                 // 文章类型
  image     String?                                 // 图片链接
  published Boolean  @default(false)               // 是否发布 (草稿状态)，默认为 false

  createdAt DateTime @default(now())               // 创建时间
  updatedAt DateTime @updatedAt                    // 更新时间
  

  // 【关系定义】：这篇文章是谁写的？
  authorId  Int                                    // 记录作者的 ID (外键)
  author    User     @relation(fields: [authorId], references: [id]) // 告诉 Prisma 这两个表的关联方式
}

